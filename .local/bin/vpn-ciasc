#! /bin/bash


openfortivpn-webview --url 'https://sslvpn01.ciasc.gov.br:443/remote/saml/start?realm=ima' > /tmp/stdout-stderr.$$

if grep "SVPNCOOKIE" /tmp/stdout-stderr.$$; then
	cookie=$(grep "SVPNCOOKIE" /tmp/stdout-stderr.$$ | cut -b 12- )
	sudo openfortivpn sslvpn01.ciasc.gov.br:443 --cookie="$cookie" &
	notify-send -t 5000 --urgency=normal -i "network-vpn-symbolic" "VPN CIASC ativada com Sucesso"
	exit 0
else
	trap 'echo "VPN CIASC: Erro ao Connectar!"; exit 0' SIGINT SIGTERM
fi


